{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Graph Builder",
  "version": "0.1.0",
  "identifier": "com.timothylasater.graphbuilder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Graph Builder", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  }
}
