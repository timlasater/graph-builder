{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Graph Builder",
  "version": "0.1.2",
  "identifier": "com.timothylasater.graphbuilder",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Graph Builder", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 600 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "fileAssociations": [{ "ext": ["graphbuilder"], "name": "Graph Builder project", "description": "Graph Builder project" }],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczQjk2MUM0NTY4OUQ4RUEKUldUcTJJbFd4R0c1YytFeHVYcWdSVzlldGdhQ2d1dFBSQ1dEdi9jVlZHbFZKbUN6d0h0ditWVUIK",
      "endpoints": ["https://github.com/timlasater/graph-builder/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
