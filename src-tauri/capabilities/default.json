{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop-files",
  "description": "Allow the main window to open and save files selected in native dialogs.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-read-file",
    "fs:allow-read-text-file",
    "fs:allow-stat",
    "fs:allow-write-file",
    "fs:allow-write-text-file"
  ]
}
